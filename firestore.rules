rules_version = '2';

// Security rules: Firebase checks these on EVERY read and write to our database.
// The website's code can't skip them, so this is what really protects our data.
//
// Who is who:
//   - Visitor:  anyone using the website (not logged in).
//   - Student:  someone signed in with Google (header button). Can send claims
//               and read their own claims.
//   - Employee: someone who logged in on the Employees page AND has a document
//               users/{their uid} with role "admin". Those documents are only
//               created by hand in the Firebase console.
//
// Deploy changes with:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function isEmployee() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Text that isn't empty and isn't longer than maxLength characters.
    function isText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    // A lost report sent from the "Report Lost Item" form.
    function isValidLostReport() {
      let report = request.resource.data;
      let fields = ["name", "category", "color", "location", "date",
                    "description", "privateDetails", "email", "createdAt"];

      return report.keys().hasOnly(fields)
        && report.keys().hasAll(fields)
        && isText(report.name, 100)
        && isText(report.category, 50)
        && isText(report.color, 50)
        && isText(report.location, 100)
        && isText(report.date, 20)
        && isText(report.description, 1000)
        && isText(report.privateDetails, 1000)
        && isText(report.email, 200)
        && report.createdAt == request.time;
    }

    // A claim sent from the "This Might Be Mine" popup by a signed-in student.
    // userId and email must be the signed-in account's own, so nobody can
    // send a claim in someone else's name.
    function isValidClaim() {
      let claim = request.resource.data;
      let fields = ["itemId", "itemName", "userId", "userName", "email",
                    "verification", "forFriend", "friendName", "friendContact",
                    "status", "createdAt"];

      return claim.keys().hasOnly(fields)
        && claim.keys().hasAll(fields)
        && claim.userId == request.auth.uid
        && claim.email == request.auth.token.email
        && isText(claim.itemId, 100)
        && isText(claim.itemName, 100)
        && isText(claim.userName, 100)
        && isText(claim.email, 200)
        && isText(claim.verification, 2000)
        && isValidFriendPart(claim)
        && claim.status == "Pending"
        && claim.createdAt == request.time
        && isStillAvailable(claim.itemId);
    }

    // "Request for a friend": a friend's name is required; contact is optional.
    // Not for a friend: both must be empty.
    function isValidFriendPart(claim) {
      return claim.friendContact is string
        && claim.friendContact.size() <= 120
        && ((claim.forFriend == true && isText(claim.friendName, 80))
            || (claim.forFriend == false && claim.friendName == "" && claim.friendContact == ""));
    }

    // The item exists and hasn't been picked up or donated yet.
    // (Items with no status yet count as available.)
    function isStillAvailable(itemId) {
      return get(/databases/$(database)/documents/items/$(itemId)).data.get("status", "available") == "available";
    }

    // A pickup record (who took an item home). Only the LAST 4 characters
    // of an ID are allowed, never a full ID number, and it must be saved by
    // the employee who is logged in.
    function isValidPickup() {
      let pickup = request.resource.data;
      let fields = ["itemId", "itemName", "claimId", "claimedBy", "forFriend",
                    "pickedUpByName", "idLast4", "releasedBy", "pickedUpAt"];

      return pickup.keys().hasOnly(fields)
        && pickup.keys().hasAll(fields)
        && isText(pickup.itemId, 100)
        && isText(pickup.itemName, 100)
        && isText(pickup.claimId, 100)
        && isText(pickup.claimedBy, 100)
        && pickup.forFriend is bool
        && isText(pickup.pickedUpByName, 80)
        && pickup.idLast4 is string
        && pickup.idLast4.matches("^[0-9A-Z]{4}$")
        && pickup.releasedBy == request.auth.token.email
        && pickup.pickedUpAt == request.time;
    }

    // ---------- Collections ----------

    // Employee list. You can read only your own entry (so the website can
    // check whether you're an employee). Nobody can change it from the website.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Found items: everyone can see them, only employees can change them.
    // Private details must NOT be saved here; they go in itemSecrets.
    match /items/{itemId} {
      allow read: if true;
      allow create, update: if isEmployee()
        && !("privateDetails" in request.resource.data);
      allow delete: if isEmployee();
    }

    // Private details of found items (same document id as the item).
    // Employees only.
    match /itemSecrets/{itemId} {
      allow read, write: if isEmployee();
    }

    // Lost reports: anyone can send one, only employees can read them.
    match /lostReports/{reportId} {
      allow create: if isValidLostReport();
      allow read, update, delete: if isEmployee();
    }

    // Claims: signed-in students can send one and read their own.
    // Employees can read and change all of them (approve, reject, picked up).
    match /claims/{claimId} {
      allow create: if request.auth != null && isValidClaim();
      allow read: if isEmployee()
        || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update, delete: if isEmployee();
    }

    // Pickup log: employees can add records and read them. Nobody can change
    // or delete a record from the website, so the log can be trusted.
    match /pickups/{pickupId} {
      allow read: if isEmployee();
      allow create: if isEmployee() && isValidPickup();
      allow update, delete: if false;
    }

    // Anything not listed above is blocked.
  }
}
